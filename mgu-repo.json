{
  "schema": 1,
  "components": [
    {
      "id": "bimmer_link",
      "kind": "app",
      "path": "apps/bimmer_link",
      "manifest": "app.json",
      "icon": "icon.png",
      "mguHmi": [
        "ID7"
      ],
      "requires": {
        "idrive7-renderd": "2.1.7",
        "mgu-inputgate": "1.0.0",
        "bimmer-link": "0.6.6"
      },
      "build": {
        "python": "kit/tools/build.py",
        "args": [
          "--language",
          "vi",
          "--plain-version",
          "{id}"
        ],
        "sdk": "oap-sdk",
        "output": "dist/{id}@{version}.tgz",
        "shared": [
          "kit/runtime",
          "kit/platform",
          "kit/localization",
          "kit/tools/build.py",
          "kit/tools/pack_data.py",
          "kit/tools/localize.py",
          "kit/tools/locale-revisions.json",
          "kit/tools/oapgen",
          "oap-sdk"
        ]
      }
    }
  ],
  "tools": [
    {
      "id": "bimmer-link",
      "path": "tools/bimmer-link",
      "title": "Trợ thủ MyBMW & 1CR",
      "mguHmi": [
        "ID7"
      ]
    }
  ]
}
