        ],
        [
          "BTN_VALET",
          "Chế độ Valet"
        ],
        [
          "BTN_SNAP",
          "Chụp gửi App"
        ],
        [
          "BTN_TIMER",
          "Hẹn giờ 1CR"
        ]
      ]
    }
