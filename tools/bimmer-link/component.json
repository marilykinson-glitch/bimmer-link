{
  "id": "bimmer-link",
  "kind": "tool",
  "version": "0.4.1",
  "title": "Trợ thủ MyBMW & 1CR",
  "description": "Dịch vụ nền cho ứng dụng MyBMW & 1CR: tự động quét đúng dòng xe qua VIN/FA, màu sơn gốc và hình xe 2D chuẩn hãng trên đầu MGU; chụp ảnh 4 camera 360° quanh xe từ xa (ICAM2) kèm thẻ vị trí đỗ hầm; giám sát Valet; điều khiển đề nổ 1CR và hẹn giờ BDC/IHKA.",
  "license": "GPL-3.0-or-later",
  "mguHmi": [
    "ID7"
  ],
  "uninstallable": true,
  "requires": {
    "mgu-deploy": "0.7.11"
  },
  "files": [
    {
      "path": "bimmer-link.js",
      "mode": "0644"
    },
    {
      "path": "car-link.js",
      "mode": "0644"
    },
    {
      "path": "car-hero.js",
      "mode": "0644"
    },
    {
      "path": "cam360.js",
      "mode": "0644"
    },
    {
      "path": "mgu-sidecam",
      "mode": "0755"
    },
    {
      "path": "carpaint.js",
      "mode": "0644"
    },
    {
      "path": "wbm.js",
      "mode": "0644"
    },
    {
      "path": "cloud.js",
      "mode": "0644"
    },
    {
      "path": "snapshot.js",
      "mode": "0644"
    },
    {
      "path": "telegram.js",
      "mode": "0644"
    },
    {
      "path": "uplink.js",
      "mode": "0644"
    },
    {
      "path": "page.html",
      "mode": "0644"
    },
    {
      "path": "NOTICE.md",
      "mode": "0644"
    },
    {
      "path": "LICENSE.GPL-3.0",
      "mode": "0644"
    },
    {
      "path": "LICENSE.MPL-2.0",
      "mode": "0644"
    },
    {
      "path": "LICENSE.ffmpeg",
      "mode": "0644"
    }
  ],
  "units": [
    {
      "name": "bimmer-link.service"
    }
  ],
  "enable": [
    {
      "unit": "bimmer-link.service",
      "target": "multi-user.target"
    }
  ],
  "recmgr": [
    "bimmer-link"
  ],
  "crashNames": [
    "mgu-sidecam"
  ],
  "restart": [
    "bimmer-link.service"
  ],
  "internet": true,
  "uids": "state/internet-uids"
}
