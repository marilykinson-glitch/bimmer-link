{
  "id": "bimmer-link",
  "kind": "tool",
  "version": "0.2.0",
  "title": "Trợ thủ MyBMW & 1CR",
  "description": "Dịch vụ nền cho ứng dụng MyBMW & 1CR: đồng bộ dữ liệu xe với ứng dụng điện thoại MyBMW (iPhone PWA & Android APK) và Telegram, gửi ảnh trạng thái khi đỗ xe, giám sát chế độ Valet, điều khiển đề nổ làm mát 1CR và hẹn giờ BDC/IHKA.",
  "license": "GPL-3.0-or-later",
  "mguHmi": [
    "ID7"
  ],
  "uninstallable": true,
  "requires": {
    "mgu-deploy": "0.7.11"
  },
  "files": [
    {
      "path": "bimmer-link.js",
      "mode": "0644"
    },
    {
      "path": "car-link.js",
      "mode": "0644"
    },
    {
      "path": "cloud.js",
      "mode": "0644"
    },
    {
      "path": "snapshot.js",
      "mode": "0644"
    },
    {
      "path": "telegram.js",
      "mode": "0644"
    },
    {
      "path": "uplink.js",
      "mode": "0644"
    },
    {
      "path": "page.html",
      "mode": "0644"
    },
    {
      "path": "LICENSE.GPL-3.0",
      "mode": "0644"
    }
  ],
  "units": [
    {
      "name": "bimmer-link.service"
    }
  ],
  "enable": [
    {
      "unit": "bimmer-link.service",
      "target": "multi-user.target"
    }
  ],
  "recmgr": [
    "bimmer-link"
  ],
  "restart": [
    "bimmer-link.service"
  ],
  "internet": true,
  "uids": "state/internet-uids"
}
