{
  "id": "bimmer-link",
  "kind": "tool",
  "version": "0.4.0",
  "title": "Trợ thủ MyBMW & 1CR",
  "description": "Dịch vụ nền cho ứng dụng MyBMW & 1CR: tự động quét đúng dòng xe, gói trang bị (M Sport / Luxury), màu sơn gốc và hình xe chuẩn hãng trên đầu MGU; đồng bộ thời gian thực với ứng dụng điện thoại MyBMW (iPhone PWA & Android APK); gửi ảnh vị trí đỗ hầm, giám sát Valet, điều khiển đề nổ 1CR và hẹn giờ BDC/IHKA.",
  "license": "GPL-3.0-or-later",
  "mguHmi": [
    "ID7"
  ],
  "uninstallable": true,
  "requires": {
    "mgu-deploy": "0.7.11"
  },
  "files": [
    {
      "path": "bimmer-link.js",
      "mode": "0644"
    },
    {
      "path": "car-link.js",
      "mode": "0644"
    },
    {
      "path": "car-hero.js",
      "mode": "0644"
    },
    {
      "path": "carpaint.js",
      "mode": "0644"
    },
    {
      "path": "wbm.js",
      "mode": "0644"
    },
    {
      "path": "cloud.js",
      "mode": "0644"
    },
    {
      "path": "snapshot.js",
      "mode": "0644"
    },
    {
      "path": "telegram.js",
      "mode": "0644"
    },
    {
      "path": "uplink.js",
      "mode": "0644"
    },
    {
      "path": "page.html",
      "mode": "0644"
    },
    {
      "path": "LICENSE.GPL-3.0",
      "mode": "0644"
    }
  ],
  "units": [
    {
      "name": "bimmer-link.service"
    }
  ],
  "enable": [
    {
      "unit": "bimmer-link.service",
      "target": "multi-user.target"
    }
  ],
  "recmgr": [
    "bimmer-link"
  ],
  "restart": [
    "bimmer-link.service"
  ],
  "internet": true,
  "uids": "state/internet-uids"
}
